<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping>
    <class name="datos.Festival" table="festival">

        <id column="idFestival" name="idFestival" type="int">
        <generator class="identity" />
        </id>

        <property column="nombre" name="nombre" type="string" />
        <property column="temporada" name="temporada" type="string" />
        <property column="fechaDeInicio" name="fechaDeInicio" type="java.time.LocalDate" />
        <property column="fechaDeFin" name="fechaDeFin" type="java.time.LocalDate" />
        <set name="platos" table="plato" lazy="true" cascade="all">
            <key column="idFestival" />
            <one-to-many class="datos.Plato" />
        </set>
    </class>
</hibernate-mapping>