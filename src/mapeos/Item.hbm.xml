<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping>
    <class name="datos.Item" table="item">
        
        <!-- ID de Item -->
        <id column="idItem" name="idItem" type="int">
        <generator class="identity" />
        </id>
        
        <!-- Atributos comunes -->
        <property column="cantidad" name="cantidad" type="int" />
        
        <!-- Relación Muchos a Uno con Plato (Clave foránea) -->
        <many-to-one name="plato" column="idPlato" class="datos.Plato" not-null="true" />
        
    </class>
</hibernate-mapping>